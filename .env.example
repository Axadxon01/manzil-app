# Manzil v3 — muhit o'zgaruvchilari (haqiqiy qiymatlarni .env yoki Render Environment'ga yozing; GitHub'ga YUKLAMANG)
NODE_ENV=production
PORT=3000
PUBLIC_URL=https://manzil.uz
# Boshqa domenlardan (masalan admin.manzil.uz) so'rov kerak bo'lsa, vergul bilan:
CORS_ORIGINS=

# Baza: fayl (Render Persistent Disk: /data) yoki :memory: (faqat sinov — o'chsa hammasi yo'qoladi)
DB_PATH=/data/manzil.db

# Birinchi super admin (bo'sh qoldirsangiz tasodifiy parol yaratiladi va logga BIR MARTA chiqadi)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Faqat DEVELOPMENT: soxta (sandbox) to'lovlarga ruxsat. NODE_ENV=production bo'lsa baribir ishlamaydi.
DEMO_PAYMENTS=false
SEED_SAMPLE_GUIDES=true

# To'lov provayderlari
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Click SHOP API: kabinetda Prepare URL = {PUBLIC_URL}/api/payments/webhook/click/prepare, Complete URL = .../click/complete
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
# Payme Merchant API: endpoint = {PUBLIC_URL}/api/payments/webhook/payme, account maydoni: order_id
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST_KEY=

# Bildirishnomalar va AI (ixtiyoriy)
# Mijozlar uchun Telegram bot (BotFather). Webhook avtomatik o'rnatiladi (PUBLIC_URL https bo'lishi kerak).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_SKIP_SETUP=false

# Xavfsizlik: production'da admin/moliya xodimlari uchun 2FA majburiy
REQUIRE_STAFF_2FA=true
# Eski/takroriy xizmatni asosiy domenga yo'naltirish (masalan ikkinchi Render instance'da)
REDIRECT_TO=

# Zaxira nusxalar (kunlik 03:30 Toshkent)
BACKUP_DIR=/data/backups
BACKUP_KEEP=14
BACKUP_DISABLED=false

# Namunaviy (demo) gid va paketlar — haqiqiy hamkorlar yetarli bo'lgach false qiling yoki admin paneldan yashiring
SEED_SAMPLE_OFFERS=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_DAILY_LIMIT=500
