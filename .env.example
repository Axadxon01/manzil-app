# Manzil Server sozlamalari  (BU FAYLNI .env deb nusxalang; .env ni hech qachon GitHub'ga yuklamang)
PORT=3000
PUBLIC_URL=http://localhost:3000
# Productionda: NODE_ENV=production (Render buni RENDER o'zgaruvchisi orqali avtomatik aniqlaydi)
# NODE_ENV=production

# ---- MAJBURIY maxfiy kalitlar (productionda bo'lmasa server ishga tushmaydi) ----
# Ikkalasini ham tasodifiy yarating, masalan:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_KEY=
JWT_SECRET=

COMMISSION_RATE=0.12

# Brauzerdan API ga murojaat qilishi mumkin bo'lgan saytlar (vergul bilan). Bo'sh bo'lsa PUBLIC_URL.
# Keyinchalik: ALLOWED_ORIGINS=https://manzil.uz,https://admin.manzil.uz
ALLOWED_ORIGINS=

# Telegram Bot (gid arizasi, taklif/shikoyat va to'lov xabarnomalari uchun)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Real AI Chat (OpenAI yoki Grok / xAI)
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROK_API_KEY=
GROK_MODEL=grok-3-mini
# Kuniga eng ko'pi bilan nechta pullik AI so'rovi (xarajatni cheklash)
AI_DAILY_LIMIT=500

# ---- To'lov ----
# Provayder ulanmagan bo'lsa productionda to'lov YARATILMAYDI (yolg'on "to'landi" yo'q).
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
PAYME_MERCHANT_ID=
STRIPE_SECRET_KEY=
# Stripe Dashboard > Developers > Webhooks > endpoint: https://SIZNING-SAYT/api/payments/webhook/stripe
STRIPE_WEBHOOK_SECRET=
# Faqat sinov uchun: productionda demo (sandbox) to'lovni yoqish. Daromadga qo'shilmaydi.
# ALLOW_DEMO_PAYMENTS=true
